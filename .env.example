# Copie para .env (ignorado pelo git) para o "expo start" local.
# Nos builds (eas build), o valor vem do "env" de cada profile no eas.json.

# Backend que o app usa.
#   Local:   o IP da sua maquina na rede + a porta do backend.
#   Staging: https://glowly-backend-fkqe.onrender.com/api
# Pode terminar com ou sem "/api" — o app normaliza.
EXPO_PUBLIC_API_URL=http://192.168.15.27:8082/api
