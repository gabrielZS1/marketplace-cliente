{
  "expo": {
    "name": "Glowly",
    "slug": "Glowly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/iconnot.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.glowly.cliente",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.glowly.cliente",
      "adaptiveIcon": {
        "foregroundImage": "./assets/iconapp.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/iconapp.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita o acesso à localização para encontrar estabelecimentos perto de você.",
          "locationAlwaysAndWhenInUsePermission": "Permita o acesso à localização para encontrar estabelecimentos perto de você.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às suas fotos para escolher uma imagem da galeria."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "6146f678-589f-4b70-b46e-7911397f3505"
      }
    },
    "owner": "gabrielzs1"
  }
}
